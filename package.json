{
    "name": "regional-starter-pack",
    "private": true,
    "version": "3.0.0-dev",
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "packageManager": "pnpm@12.16.1",
    "homepage": "https://www.regionalstarterpack.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/ElliotFriend/regional-starter-pack"
    },
    "scripts": {
        "dev": "vite dev",
        "dev:v1": "vite dev --mode v1",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test": "vitest",
        "test:client": "vitest --project client",
        "test:unit": "vitest --project unit",
        "test:integration": "vitest --project integration",
        "test:run": "vitest run",
        "clear": "rm -rf .svelte-kit && rm -rf build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/adapter-vercel": "^7.0.2",
        "@sveltejs/kit": "^3.1.1",
        "@sveltejs/load-config": "^0.2.3",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.6",
        "@vitest/browser-playwright": "^5.0.5",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.23.1",
        "globals": "^17.13.0",
        "msw": "^3.0.3",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vitest-browser-svelte": "^3.1.0"
    },
    "dependencies": {
        "@lucide/svelte": "^1.66.0",
        "@stellar/stellar-sdk": "^17.4.0",
        "@stellar/varial-sdk": "^7.0.0"
    },
    "engines": {
        "node": "26.x"
    }
}
